opam-version: "2.0"
name: "voxgig-univec-sdk"
version: "0.1.1"
synopsis: "Univec SDK for OCaml (generated by @voxgig/sdkgen)"
maintainer: "Voxgig"
authors: "Voxgig"
license: "MIT"
homepage: "https://voxgig.com"
bug-reports: "https://voxgig.com"
# The generated SDK is dependency-free: it compiles with the stock ocamlc
# (see the Makefile). No opam packages, no dune.
depends: [
  "ocaml" {>= "4.14"}
]
build: [
  [make "build"]
]
