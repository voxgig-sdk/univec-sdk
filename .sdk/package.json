{
  "name": "build-univec-sdk",
  "version": "0.0.1",
  "description": "Univec SDK Project",
  "scripts": {
    "generate": "node build/docgen.js && tsc --build src && voxgig-model model/sdk.aontu && voxgig-model test/test.aontu",
    "watch-generate": "voxgig-model -w model/sdk.aontu",
    "dry-generate": "tsc --build src && voxgig-model -y model/sdk.aontu",
    "watch-dry-generate": "voxgig-model -w -y model/sdk.aontu",
    "test-model": "voxgig-model test/test.aontu",
    "watch-test-model": "voxgig-model -w test/test.aontu",
    "watch": "tsc --build src -w",
    "build": "tsc --build src",
    "test": "echo no-test",
    "clean": "rm -rf dist dist-test node_modules yarn.lock package-lock.json",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "add-target": "voxgig-sdkgen target add",
    "dry-add-target": "voxgig-sdkgen -y target add",
    "add-feature": "voxgig-sdkgen feature add",
    "dry-add-feature": "voxgig-sdkgen -y feature add",
    "add-edition": "voxgig-sdkgen edition add",
    "text-qa": "cd .. && voxgig-docgen qa",
    "postinstall": "node build/docgen.js",
    "status": "bash admin/status.sh",
    "check-drift": "bash admin/check-drift.sh"
  },
  "author": "Univec",
  "license": "MIT",
  "devDependencies": {
    "@types/node": ">=25.6",
    "@voxgig/apidef": "~8.25.0",
    "@voxgig/docgen": "~0.30.1",
    "@voxgig/model": "~12.0.1",
    "@voxgig/sdkgen": "~4.34.3",
    "@voxgig/sdkgen-langpack": "^0.0.11",
    "@voxgig/struct": ">=0.2",
    "@voxgig/util": ">=0.5",
    "aontu": ">=0.75.0",
    "jostraca": ">=0.39.0",
    "typescript": ">=6.0"
  }
}
