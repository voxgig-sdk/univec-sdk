# Guide corrections and live recipes. The definition remains unchanged.
@"@voxgig/apidef/model/guide.aon"
@"base-guide.aon"
guide: entity: {
  "model": {
    "path": {
      "/v1/models": {
        "op": {
          "list": {
            "live": {
              "id": "models",
              "auth": "public",
              "assert": {
                "nonempty": [
                  ""
                ]
              }
            },
            "contract": {
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "data": {
                            "items": {
                              "oneOf": [
                                {
                                  "properties": {
                                    "eval": {
                                      "description": "Retrieval-fidelity metrics for a convert model.",
                                      "properties": {
                                        "cosine_mean": {
                                          "format": "float",
                                          "type": "number"
                                        },
                                        "cosine_median": {
                                          "format": "float",
                                          "type": "number"
                                        },
                                        "cosine_std": {
                                          "format": "float",
                                          "type": "number"
                                        },
                                        "kendall_p_value": {
                                          "format": "float",
                                          "type": "number"
                                        },
                                        "kendall_tau": {
                                          "format": "float",
                                          "type": "number"
                                        },
                                        "mrr": {
                                          "description": "Mean reciprocal rank.",
                                          "format": "float",
                                          "type": "number"
                                        },
                                        "p_at_1": {
                                          "format": "float",
                                          "type": "number"
                                        },
                                        "p_at_10": {
                                          "format": "float",
                                          "type": "number"
                                        },
                                        "p_at_5": {
                                          "format": "float",
                                          "type": "number"
                                        }
                                      },
                                      "type": "object"
                                    },
                                    "executionProvider": {
                                      "description": "Hardware backend, e.g. `cpu`.",
                                      "type": "string"
                                    },
                                    "modelCard": {
                                      "additionalProperties": true,
                                      "description": "Convert models only: training provenance and architecture detail.",
                                      "type": "object"
                                    },
                                    "modelType": {
                                      "description": "`embed` for text-to-vector models, `convert` for space-translation models.",
                                      "enum": [
                                        "embed",
                                        "convert"
                                      ],
                                      "type": "string"
                                    },
                                    "name": {
                                      "description": "Model identifier used in requests.",
                                      "type": "string"
                                    },
                                    "sequenceLen": {
                                      "description": "Embed models only: maximum input sequence length.",
                                      "type": "integer"
                                    },
                                    "sourceDim": {
                                      "description": "Convert models only: source vector dimension.",
                                      "type": "integer"
                                    },
                                    "sourceModel": {
                                      "description": "Convert models only: the source model space.",
                                      "type": "string"
                                    },
                                    "targetDim": {
                                      "description": "Dimension of the produced vectors.",
                                      "type": "integer"
                                    },
                                    "targetModel": {
                                      "description": "The model space produced.",
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "name",
                                    "modelType",
                                    "targetModel",
                                    "targetDim"
                                  ],
                                  "type": "object"
                                },
                                {
                                  "type": "object",
                                  "required": [
                                    "name",
                                    "modelType",
                                    "executionProvider"
                                  ],
                                  "properties": {
                                    "name": {
                                      "type": "string"
                                    },
                                    "modelType": {
                                      "type": "string",
                                      "enum": [
                                        "convert-bridge",
                                        "embed-bridge"
                                      ]
                                    },
                                    "executionProvider": {
                                      "type": "string"
                                    },
                                    "restrictedTargets": {
                                      "type": "array",
                                      "items": {
                                        "type": "string"
                                      }
                                    }
                                  }
                                }
                              ]
                            },
                            "type": "array"
                          },
                          "success": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "success",
                          "data"
                        ],
                        "type": "object"
                      }
                    }
                  },
                  "description": "Model list"
                }
              }
            }
          }
        }
      }
    }
  },
  "ephemeral_key": {
    "path": {
      "/v1/ephemeral/key": {
        "op": {
          "create": {
            "live": {
              "id": "key",
              "auth": "public",
              "input": {},
              "assert": {
                "nonempty": [
                  "key"
                ]
              },
              "retention": "No deletion endpoint; issued key is subject to the service daily allowance"
            }
          }
        }
      }
    }
  },
  "embed": {
    "path": {
      "/v1/embed": {
        "op": {
          "create": {
            "live": {
              "id": "account-embed",
              "auth": "account",
              "input": {
                "model": {
                  "from": "models",
                  "where": {
                    "modelType": "convert"
                  },
                  "related": {
                    "from": "models",
                    "local": "sourceModel",
                    "foreign": "name",
                    "where": {
                      "modelType": "embed"
                    }
                  },
                  "path": "sourceModel"
                },
                "texts": [
                  "SDK live coverage test."
                ]
              },
              "assert": {
                "equal": {
                  "model": {
                    "from": "models",
                    "where": {
                      "modelType": "convert"
                    },
                    "related": {
                      "from": "models",
                      "local": "sourceModel",
                      "foreign": "name",
                      "where": {
                        "modelType": "embed"
                      }
                    },
                    "path": "sourceModel"
                  }
                },
                "vectors": {
                  "path": "embeddings",
                  "count": 1,
                  "dimension": {
                    "from": "models",
                    "where": {
                      "modelType": "convert"
                    },
                    "related": {
                      "from": "models",
                      "local": "sourceModel",
                      "foreign": "name",
                      "where": {
                        "modelType": "embed"
                      }
                    },
                    "path": "sourceDim"
                  }
                }
              }
            }
          }
        }
      },
      "/v1/ephemeral/embed": {
        "op": {
          "create": {
            "live": {
              "id": "ephemeral-embed",
              "auth": "issued",
              "credential": {
                "from": "key",
                "path": "key"
              },
              "input": {
                "model": {
                  "from": "models",
                  "where": {
                    "modelType": "convert"
                  },
                  "related": {
                    "from": "models",
                    "local": "sourceModel",
                    "foreign": "name",
                    "where": {
                      "modelType": "embed"
                    }
                  },
                  "path": "sourceModel"
                },
                "texts": [
                  "SDK live coverage test."
                ]
              },
              "assert": {
                "equal": {
                  "model": {
                    "from": "models",
                    "where": {
                      "modelType": "convert"
                    },
                    "related": {
                      "from": "models",
                      "local": "sourceModel",
                      "foreign": "name",
                      "where": {
                        "modelType": "embed"
                      }
                    },
                    "path": "sourceModel"
                  }
                },
                "vectors": {
                  "path": "embeddings",
                  "count": 1,
                  "dimension": {
                    "from": "models",
                    "where": {
                      "modelType": "convert"
                    },
                    "related": {
                      "from": "models",
                      "local": "sourceModel",
                      "foreign": "name",
                      "where": {
                        "modelType": "embed"
                      }
                    },
                    "path": "sourceDim"
                  }
                }
              }
            }
          }
        },
        "action": {
          "ephemeral": {}
        }
      }
    }
  },
  "convert": {
