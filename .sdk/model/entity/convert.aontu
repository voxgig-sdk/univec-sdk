# Entity: convert

main: kit: entity: convert: {

  alias: field: {}

  fields: {
    embeddings: {
      h: "Embeddings"
      n: "embeddings"
      r: true
      sh: "Translated vectors, in the target model's dimension."
      t: "`$ARRAY`"
    }
    source_model: {
      h: "Source Model"
      n: "source_model"
      r: true
      sh: "Model space the supplied vectors are currently in."
      t: "`$STRING`"
    }
    target_model: {
      h: "Target Model"
