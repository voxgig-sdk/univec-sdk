# Entity: convert

main: kit: entity: convert: {

  alias: field: {}

  fields: [
    {
      name: "bridge_model"
      req: true
      short: "Embed model used to vectorise the text before translation."
      type: "`$STRING`"
    }
    {
      name: "embeddings"
      req: true
      short: "Translated vectors, in the target model's dimension."
      type: "`$ARRAY`"
    }
    {
      name: "source_model"
      req: true
      short: "Model space the supplied vectors are currently in."
      type: "`$STRING`"
    }
    {
      name: "target_model"
      req: true
      short: "Model space to translate into."
      type: "`$STRING`"
    }
    {
      name: "texts"
      req: true
      short: "Texts to embed and translate."
      type: "`$ARRAY`"
    }
  ]

  name: "convert"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/v1/convert"
          parts: [
            "v1"
            "convert"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/v1/embed-bridge"
          parts: [
            "v1"
            "embed-bridge"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/v1/ephemeral/convert"
          parts: [
            "v1"
            "ephemeral"
            "convert"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/v1/ephemeral/embed-bridge"
          parts: [
            "v1"
            "ephemeral"
            "embed-bridge"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
