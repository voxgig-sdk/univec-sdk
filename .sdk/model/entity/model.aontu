# Entity: model

main: kit: entity: model: {

  alias: field: {}

  fields: [
    {
      name: "eval"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "executionProvider"
      req: false
      type: "`$STRING`"
    }
    {
      name: "modelCard"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "modelType"
      req: true
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      type: "`$STRING`"
    }
    {
      name: "sequenceLen"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "sourceDim"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "sourceModel"
      req: false
      type: "`$STRING`"
    }
    {
      name: "targetDim"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "targetModel"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "model"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/v1/models"
          parts: [
            "v1"
            "models"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
