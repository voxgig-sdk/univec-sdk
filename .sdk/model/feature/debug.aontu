
main: kit: feature: debug: {

  name: key()
  title: "Debug capture"
  description: "Request/response capture ring buffer for debugging"
  version: '0.0.1'
  active: true
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  transport: 'none'

  config: {
    options: {
      active: false
      # maximum retained entries
      max: 100
      # header names masked in captured traces IN ADDITION to the SDK's own
      # clean rules (clean.keys and every registered secret value), which
      # apply to the whole entry, url and error message included
      redact: ['authorization', 'cookie', 'set-cookie', 'api-key', 'apikey', 'x-api-key', 'idempotency-key']
    }
  }

  hook: {
    PreRequest: active: true
    PreResponse: active: true
    PreDone: active: true
    PreUnexpected: active: true
  }
}


main: kit: feature: debug: config: optspec: {
  # injected clock, so a trace has stable durations
  now: '`$FUNCTION`'
  # receives each trace entry as it is recorded
  onEntry: '`$FUNCTION`'
}
