
main: kit: feature: secrets: {

  name: key()
  title: "Secrets"
  description: "Secret access: resolve the API credential through a provider chain, and exchange a refresh token for short-lived access tokens"
  version: '0.1.0'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'


  # Applicability (docs/design/feature-tags.md). The feature is a thin
  # layer over a VENDORED sekreto port, so it only applies to a target
  # whose feature container carries one. Without this tag the feature
  # would fan out to every target, and each one that generated would
  # carry an import for a class it has no source for.
  needs: { sekreto: true }

  spec: { authexchange: 'exchange' }

  plugin: {

    vault: {
      title: 'HashiCorp Vault and boru'
      needs: { fs: true, fetch: true }
      path: [
        'src/feature/secrets/sekreto/plugins/hashicorp.ts'
        'src/feature/secrets/sekreto/plugins/boru.ts'
        'feature/secrets/plugins/hashicorp/hashicorp.go'
        'feature/secrets/plugins/boru/boru.go'
        'feature/secrets/plugins/hashicorp.rs'
        'feature/secrets/plugins/boru.rs'
        'feature/secrets/voxgig_sekreto/plugins/hashicorp.py'
        'feature/secrets/voxgig_sekreto/plugins/boru.py'
        'src/feature/secrets/sekreto/plugins/hashicorp.js'
        'src/feature/secrets/sekreto/plugins/boru.js'
        'feature/secrets/voxgig_sekreto/plugins/hashicorp.rb'
        'feature/secrets/voxgig_sekreto/plugins/boru.rb'
        'feature/secrets/sekreto/plugins/hashicorp.php'
        'feature/secrets/sekreto/plugins/boru.php'
        'feature/secrets/plugins/Hashicorp.cs'
        'feature/secrets/plugins/Boru.cs'
        'feature/secrets/sekreto/plugins/Hashicorp.java'
        'feature/secrets/sekreto/plugins/Boru.java'
        'feature/secrets/sekreto/plugins/Hashicorp.scala'
        'feature/secrets/sekreto/plugins/Boru.scala'
        'feature/secrets/sekreto/plugins/Hashicorp.kt'
        'feature/secrets/sekreto/plugins/Boru.kt'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Hashicorp.pm'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Boru.pm'
        'lib/feature/secrets/sekreto/plugins/hashicorp.dart'
        'lib/feature/secrets/sekreto/plugins/boru.dart'
        'feature/secrets/sekreto/plugins/hashicorp.ex'
        'feature/secrets/sekreto/plugins/boru.ex'
        'feature/secrets/voxgig/sekreto/plugins/hashicorp.clj'
        'feature/secrets/voxgig/sekreto/plugins/boru.clj'
        'feature/secrets/plugins/Hashicorp.swift'
        'feature/secrets/plugins/Boru.swift'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Hashicorp.lean'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Boru.lean'
        'feature/secrets/plugins/hashicorp.c'
        'feature/secrets/plugins/boru.c'
        'feature/secrets/sekreto/plugins/hashicorp.lua'
        'feature/secrets/sekreto/plugins/boru.lua'
        'feature/secrets/plugins/hashicorp.zig'
        'feature/secrets/plugins/boru.zig'
        'feature/secrets/plugins/hashicorp.ml'
        'feature/secrets/plugins/boru.ml'
        'feature/secrets/plugins/Hashicorp.cpp'
        'feature/secrets/plugins/Hashicorp.hpp'
        'feature/secrets/plugins/Boru.cpp'
        'feature/secrets/plugins/Boru.hpp'
      ]
      def: ts: {
        hashicorp: 'src/feature/secrets/sekreto/plugins/hashicorp.ts'
        boru: 'src/feature/secrets/sekreto/plugins/boru.ts'
      }
      def: go: {
        'hashicorp.Plugin': 'feature/secrets/plugins/hashicorp/hashicorp.go'
        'boru.Plugin': 'feature/secrets/plugins/boru/boru.go'
      }
      # rust: module-qualified `pub fn` paths under
      # feature/secrets/plugins/ (Main_rust emits the plugins.rs module
      # index from these, one `pub mod` per owning file). The path is
      # target-root-relative, as go's is.
      def: rust: {
        'hashicorp::plugin': 'feature/secrets/plugins/hashicorp.rs'
        'boru::plugin': 'feature/secrets/plugins/boru.rs'
      }
      # py: module paths relative to the SDK package root (Main_py copies
      # tm/py/pkg INTO <name>_sdk/, so the trim patterns drop the leading
      # pkg/ while Config_py derives the import module from it).
      def: py: {
        hashicorp: 'pkg/feature/secrets/voxgig_sekreto/plugins/hashicorp.py'
        boru: 'pkg/feature/secrets/voxgig_sekreto/plugins/boru.py'
      }
      # rb: constant names under VoxgigSekreto::Plugins, and the module
      # path under tm/rb that config.rb turns into a require_relative
      # (target-root-relative, as go's are).
      def: rb: {
        'VoxgigSekreto::Plugins::HASHICORP': 'feature/secrets/voxgig_sekreto/plugins/hashicorp.rb'
        'VoxgigSekreto::Plugins::BORU': 'feature/secrets/voxgig_sekreto/plugins/boru.rb'
      }
      def: js: {
        hashicorp: 'src/feature/secrets/sekreto/plugins/hashicorp.js'
        boru: 'src/feature/secrets/sekreto/plugins/boru.js'
      }
      # php: the plugin FUNCTION each file exports (a definition holds
      # closures, so php cannot name it with a constant), and the module
      # path under tm/php - this target's root, which is also config.php's
      # own directory, so the emitted require_once is that path verbatim.
      def: php: {
        hashicorp: 'feature/secrets/sekreto/plugins/hashicorp.php'
        boru: 'feature/secrets/sekreto/plugins/boru.php'
      }
      # csharp: the static class and Definition FIELD each file exports,
      # under namespace Voxgig.Sekreto.Plugins (Config_csharp emits the
      # symbol `global::`-qualified, so an inactive group leaves no
      # reference and no dangling using). The path is target-root-relative,
      # as go's is.
      def: csharp: {
        'Hashicorp.Plugin': 'feature/secrets/plugins/Hashicorp.cs'
        'Boru.Plugin': 'feature/secrets/plugins/Boru.cs'
      }
      # java: class-qualified Definition symbols (one class per kind),
      # and the file path under tm/java - this target's root, which is
      # also Main_java's Copy root, so the emitted exclude matches it.
      def: java: {
        'Hashicorp.PLUGIN': 'feature/secrets/sekreto/plugins/Hashicorp.java'
        'Boru.PLUGIN': 'feature/secrets/sekreto/plugins/Boru.java'
      }
      # scala: fully-qualified top-level `val`s (the scala port makes each
      # plugin a package-level Definition), so Config_scala names them
      # without an import. The path is target-root-relative, as go's is.
      def: scala: {
        'com.voxgig.sekreto.plugins.hashicorp': 'feature/secrets/sekreto/plugins/Hashicorp.scala'
        'com.voxgig.sekreto.plugins.boru': 'feature/secrets/sekreto/plugins/Boru.scala'
      }
      # kotlin: PLAIN TOP-LEVEL VALS (`val hashicorp: Definition = ...`),
      # imported by simple name - so ts-shaped keys, not java's
      # class-qualified ones. The path is target-root-relative, as go's is,
      # because Main_kotlin's Copy is rooted at tm/kotlin.
      def: kotlin: {
        hashicorp: 'feature/secrets/sekreto/plugins/Hashicorp.kt'
        boru: 'feature/secrets/sekreto/plugins/Boru.kt'
      }
      def: perl: {
        hashicorp: 'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Hashicorp.pm'
        boru: 'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Boru.pm'
      }
      # dart: PLAIN TOP-LEVEL FINALS (`final Definition hashicorp = ...`),
      # imported by simple name with a `show` clause - so ts-shaped keys.
      # The path is target-root-relative, as go's is, because Main_dart's
      # Copy is rooted at tm/dart; `lib/` is part of it because dart's
      # feature container is lib/feature/<name>/, not a src/ tree.
      def: dart: {
        hashicorp: 'lib/feature/secrets/sekreto/plugins/hashicorp.dart'
        boru: 'lib/feature/secrets/sekreto/plugins/boru.dart'
      }
      # clojure: FULLY-QUALIFIED VARS (`voxgig.sekreto.plugins.hashicorp/hashicorp`)
      # - the clojure spelling of go's package-qualified symbol.
      # Config_clojure derives the `:require` namespace from the part before
      # the `/`. The path is target-root-relative, as go's is, because
      # Main_clojure's Copy is rooted at tm/clojure.
      def: clojure: {
        'voxgig.sekreto.plugins.hashicorp/hashicorp': 'feature/secrets/voxgig/sekreto/plugins/hashicorp.clj'
        'voxgig.sekreto.plugins.boru/boru': 'feature/secrets/voxgig/sekreto/plugins/boru.clj'
      }
      def: elixir: {
        'Sekreto.Plugins.Hashicorp.hashicorp': 'lib/projectname/feature/secrets/sekreto/plugins/hashicorp.ex'
        'Sekreto.Plugins.Boru.boru': 'lib/projectname/feature/secrets/sekreto/plugins/boru.ex'
      }
      def: swift: {
        hashicorp: 'Sources/ProjectNameSDK/feature/secrets/plugins/Hashicorp.swift'
        boru: 'Sources/ProjectNameSDK/feature/secrets/plugins/Boru.swift'
      }
      def: lean: {
        'Sekreto.hashicorp': 'src/feature/secrets/sekreto/plugins/SekretoPlugins/Hashicorp.lean'
        'Sekreto.boru': 'src/feature/secrets/sekreto/plugins/SekretoPlugins/Boru.lean'
      }
      def: c: {
        sek_plugin_hashicorp: 'feature/secrets/plugins/hashicorp.c'
        sek_plugin_boru: 'feature/secrets/plugins/boru.c'
      }
      # lua: the FIELD each module exports (`require('...hashicorp').hashicorp`
      # is upstream's own spelling; aws.lua exports awssecrets AND awsparams),
      # and the module path under tm/lua - this target's root, which is also
      # Main_lua's Copy root, so the emitted exclude matches it. Config_lua
      # turns the path into a require (strip .lua, slashes to dots).
      def: lua: {
        hashicorp: 'feature/secrets/sekreto/plugins/hashicorp.lua'
        boru: 'feature/secrets/sekreto/plugins/boru.lua'
      }
      def: zig: {
        hashicorp: 'feature/secrets/plugins/hashicorp.zig'
        boru: 'feature/secrets/plugins/boru.zig'
      }
      def: ocaml: {
        'Hashicorp.plugin': 'feature/secrets/plugins/hashicorp.ml'
        'Boru.plugin': 'feature/secrets/plugins/boru.ml'
      }
      def: cpp: {
        hashicorp: 'feature/secrets/plugins/Hashicorp.cpp'
        boru: 'feature/secrets/plugins/Boru.cpp'
      }
    }

    cloud: {
      title: 'GCP Secret Manager and Azure Key Vault'
      needs: { fetch: true }
      path: [
        'src/feature/secrets/sekreto/plugins/gcpsecrets.ts'
        'src/feature/secrets/sekreto/plugins/azuresecrets.ts'
        'feature/secrets/plugins/gcpsecrets/gcpsecrets.go'
        'feature/secrets/plugins/azuresecrets/azuresecrets.go'
        'feature/secrets/plugins/gcpsecrets.rs'
        'feature/secrets/plugins/azuresecrets.rs'
        'feature/secrets/voxgig_sekreto/plugins/gcpsecrets.py'
        'feature/secrets/voxgig_sekreto/plugins/azuresecrets.py'
        'src/feature/secrets/sekreto/plugins/gcpsecrets.js'
        'src/feature/secrets/sekreto/plugins/azuresecrets.js'
        'feature/secrets/voxgig_sekreto/plugins/gcpsecrets.rb'
        'feature/secrets/voxgig_sekreto/plugins/azuresecrets.rb'
        'feature/secrets/sekreto/plugins/gcpsecrets.php'
        'feature/secrets/sekreto/plugins/azuresecrets.php'
        'feature/secrets/plugins/GcpSecrets.cs'
        'feature/secrets/plugins/AzureSecrets.cs'
        'feature/secrets/sekreto/plugins/Gcpsecrets.java'
        'feature/secrets/sekreto/plugins/Azuresecrets.java'
        'feature/secrets/sekreto/plugins/Gcpsecrets.scala'
        'feature/secrets/sekreto/plugins/Azuresecrets.scala'
        'feature/secrets/sekreto/plugins/Gcpsecrets.kt'
        'feature/secrets/sekreto/plugins/Azuresecrets.kt'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Gcpsecrets.pm'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Azuresecrets.pm'
        'lib/feature/secrets/sekreto/plugins/gcpsecrets.dart'
        'lib/feature/secrets/sekreto/plugins/azuresecrets.dart'
        'feature/secrets/sekreto/plugins/gcpsecrets.ex'
        'feature/secrets/sekreto/plugins/azuresecrets.ex'
        'feature/secrets/voxgig/sekreto/plugins/gcpsecrets.clj'
        'feature/secrets/voxgig/sekreto/plugins/azuresecrets.clj'
        'feature/secrets/plugins/Gcpsecrets.swift'
        'feature/secrets/plugins/Azuresecrets.swift'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Gcpsecrets.lean'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Azuresecrets.lean'
        'feature/secrets/plugins/gcpsecrets.c'
        'feature/secrets/plugins/azuresecrets.c'
        'feature/secrets/sekreto/plugins/gcpsecrets.lua'
        'feature/secrets/sekreto/plugins/azuresecrets.lua'
        'feature/secrets/plugins/gcpsecrets.zig'
        'feature/secrets/plugins/azuresecrets.zig'
        'feature/secrets/plugins/gcpsecrets.ml'
        'feature/secrets/plugins/azuresecrets.ml'
        'feature/secrets/plugins/Gcpsecrets.cpp'
        'feature/secrets/plugins/Gcpsecrets.hpp'
        'feature/secrets/plugins/Azuresecrets.cpp'
        'feature/secrets/plugins/Azuresecrets.hpp'
      ]
      def: ts: {
        gcpsecrets: 'src/feature/secrets/sekreto/plugins/gcpsecrets.ts'
        azuresecrets: 'src/feature/secrets/sekreto/plugins/azuresecrets.ts'
      }
      def: go: {
        'gcpsecrets.Plugin': 'feature/secrets/plugins/gcpsecrets/gcpsecrets.go'
        'azuresecrets.Plugin': 'feature/secrets/plugins/azuresecrets/azuresecrets.go'
      }
      def: rust: {
        'gcpsecrets::plugin': 'feature/secrets/plugins/gcpsecrets.rs'
        'azuresecrets::plugin': 'feature/secrets/plugins/azuresecrets.rs'
      }
      def: py: {
        gcpsecrets: 'pkg/feature/secrets/voxgig_sekreto/plugins/gcpsecrets.py'
        azuresecrets: 'pkg/feature/secrets/voxgig_sekreto/plugins/azuresecrets.py'
      }
      def: rb: {
        'VoxgigSekreto::Plugins::GCPSECRETS': 'feature/secrets/voxgig_sekreto/plugins/gcpsecrets.rb'
        'VoxgigSekreto::Plugins::AZURESECRETS': 'feature/secrets/voxgig_sekreto/plugins/azuresecrets.rb'
      }
      def: js: {
        gcpsecrets: 'src/feature/secrets/sekreto/plugins/gcpsecrets.js'
        azuresecrets: 'src/feature/secrets/sekreto/plugins/azuresecrets.js'
      }
      def: php: {
        gcpsecrets: 'feature/secrets/sekreto/plugins/gcpsecrets.php'
        azuresecrets: 'feature/secrets/sekreto/plugins/azuresecrets.php'
      }
      def: csharp: {
        'GcpSecrets.Plugin': 'feature/secrets/plugins/GcpSecrets.cs'
        'AzureSecrets.Plugin': 'feature/secrets/plugins/AzureSecrets.cs'
      }
      def: java: {
        'Gcpsecrets.PLUGIN': 'feature/secrets/sekreto/plugins/Gcpsecrets.java'
        'Azuresecrets.PLUGIN': 'feature/secrets/sekreto/plugins/Azuresecrets.java'
      }
      def: scala: {
        'com.voxgig.sekreto.plugins.gcpsecrets': 'feature/secrets/sekreto/plugins/Gcpsecrets.scala'
        'com.voxgig.sekreto.plugins.azuresecrets': 'feature/secrets/sekreto/plugins/Azuresecrets.scala'
      }
      def: kotlin: {
        gcpsecrets: 'feature/secrets/sekreto/plugins/Gcpsecrets.kt'
        azuresecrets: 'feature/secrets/sekreto/plugins/Azuresecrets.kt'
      }
      def: perl: {
        gcpsecrets: 'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Gcpsecrets.pm'
        azuresecrets: 'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Azuresecrets.pm'
      }
      def: dart: {
        gcpsecrets: 'lib/feature/secrets/sekreto/plugins/gcpsecrets.dart'
        azuresecrets: 'lib/feature/secrets/sekreto/plugins/azuresecrets.dart'
      }
      def: clojure: {
        'voxgig.sekreto.plugins.gcpsecrets/gcpsecrets': 'feature/secrets/voxgig/sekreto/plugins/gcpsecrets.clj'
        'voxgig.sekreto.plugins.azuresecrets/azuresecrets': 'feature/secrets/voxgig/sekreto/plugins/azuresecrets.clj'
      }
      def: elixir: {
        'Sekreto.Plugins.Gcpsecrets.gcpsecrets': 'lib/projectname/feature/secrets/sekreto/plugins/gcpsecrets.ex'
        'Sekreto.Plugins.Azuresecrets.azuresecrets': 'lib/projectname/feature/secrets/sekreto/plugins/azuresecrets.ex'
      }
      def: swift: {
        gcpsecrets: 'Sources/ProjectNameSDK/feature/secrets/plugins/Gcpsecrets.swift'
        azuresecrets: 'Sources/ProjectNameSDK/feature/secrets/plugins/Azuresecrets.swift'
      }
      def: lean: {
        'Sekreto.gcpsecrets': 'src/feature/secrets/sekreto/plugins/SekretoPlugins/Gcpsecrets.lean'
        'Sekreto.azuresecrets': 'src/feature/secrets/sekreto/plugins/SekretoPlugins/Azuresecrets.lean'
      }
      def: c: {
        sek_plugin_gcpsecrets: 'feature/secrets/plugins/gcpsecrets.c'
        sek_plugin_azuresecrets: 'feature/secrets/plugins/azuresecrets.c'
      }
      # lua: the FIELD each module exports (`require('...hashicorp').hashicorp`
      # is upstream's own spelling; aws.lua exports awssecrets AND awsparams),
      # and the module path under tm/lua - this target's root, which is also
      # Main_lua's Copy root, so the emitted exclude matches it. Config_lua
      # turns the path into a require (strip .lua, slashes to dots).
      def: lua: {
        gcpsecrets: 'feature/secrets/sekreto/plugins/gcpsecrets.lua'
        azuresecrets: 'feature/secrets/sekreto/plugins/azuresecrets.lua'
      }
      def: zig: {
        gcpsecrets: 'feature/secrets/plugins/gcpsecrets.zig'
        azuresecrets: 'feature/secrets/plugins/azuresecrets.zig'
      }
      def: ocaml: {
        'Gcpsecrets.plugin': 'feature/secrets/plugins/gcpsecrets.ml'
        'Azuresecrets.plugin': 'feature/secrets/plugins/azuresecrets.ml'
      }
      def: cpp: {
        gcpsecrets: 'feature/secrets/plugins/Gcpsecrets.cpp'
        azuresecrets: 'feature/secrets/plugins/Azuresecrets.cpp'
      }
    }

    saas: {
      title: '1Password, Doppler and Infisical'
      needs: { fetch: true }
      path: [
        'src/feature/secrets/sekreto/plugins/onepassword.ts'
        'src/feature/secrets/sekreto/plugins/doppler.ts'
        'src/feature/secrets/sekreto/plugins/infisical.ts'
        'feature/secrets/plugins/onepassword/onepassword.go'
        'feature/secrets/plugins/doppler/doppler.go'
        'feature/secrets/plugins/infisical/infisical.go'
        'feature/secrets/plugins/onepassword.rs'
        'feature/secrets/plugins/doppler.rs'
        'feature/secrets/plugins/infisical.rs'
        'feature/secrets/voxgig_sekreto/plugins/onepassword.py'
        'feature/secrets/voxgig_sekreto/plugins/doppler.py'
        'feature/secrets/voxgig_sekreto/plugins/infisical.py'
        'src/feature/secrets/sekreto/plugins/onepassword.js'
        'src/feature/secrets/sekreto/plugins/doppler.js'
        'src/feature/secrets/sekreto/plugins/infisical.js'
        'feature/secrets/voxgig_sekreto/plugins/onepassword.rb'
        'feature/secrets/voxgig_sekreto/plugins/doppler.rb'
        'feature/secrets/voxgig_sekreto/plugins/infisical.rb'
        'feature/secrets/sekreto/plugins/onepassword.php'
        'feature/secrets/sekreto/plugins/doppler.php'
        'feature/secrets/sekreto/plugins/infisical.php'
        'feature/secrets/plugins/OnePassword.cs'
        'feature/secrets/plugins/Doppler.cs'
        'feature/secrets/plugins/Infisical.cs'
        'feature/secrets/sekreto/plugins/Onepassword.java'
        'feature/secrets/sekreto/plugins/Doppler.java'
        'feature/secrets/sekreto/plugins/Infisical.java'
        'feature/secrets/sekreto/plugins/Onepassword.scala'
        'feature/secrets/sekreto/plugins/Doppler.scala'
        'feature/secrets/sekreto/plugins/Infisical.scala'
        'feature/secrets/sekreto/plugins/Onepassword.kt'
        'feature/secrets/sekreto/plugins/Doppler.kt'
        'feature/secrets/sekreto/plugins/Infisical.kt'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Onepassword.pm'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Doppler.pm'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Infisical.pm'
        'lib/feature/secrets/sekreto/plugins/onepassword.dart'
        'lib/feature/secrets/sekreto/plugins/doppler.dart'
        'lib/feature/secrets/sekreto/plugins/infisical.dart'
        'feature/secrets/voxgig/sekreto/plugins/onepassword.clj'
        'feature/secrets/voxgig/sekreto/plugins/doppler.clj'
        'feature/secrets/voxgig/sekreto/plugins/infisical.clj'
        'feature/secrets/sekreto/plugins/onepassword.ex'
        'feature/secrets/sekreto/plugins/doppler.ex'
        'feature/secrets/sekreto/plugins/infisical.ex'
        'feature/secrets/plugins/Onepassword.swift'
        'feature/secrets/plugins/Doppler.swift'
        'feature/secrets/plugins/Infisical.swift'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Onepassword.lean'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Doppler.lean'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Infisical.lean'
        'feature/secrets/plugins/onepassword.c'
        'feature/secrets/plugins/doppler.c'
        'feature/secrets/plugins/infisical.c'
        'feature/secrets/sekreto/plugins/onepassword.lua'
        'feature/secrets/sekreto/plugins/doppler.lua'
        'feature/secrets/sekreto/plugins/infisical.lua'
        'feature/secrets/plugins/onepassword.zig'
        'feature/secrets/plugins/doppler.zig'
        'feature/secrets/plugins/infisical.zig'
        'feature/secrets/plugins/onepassword.ml'
        'feature/secrets/plugins/doppler.ml'
        'feature/secrets/plugins/infisical.ml'
        'feature/secrets/plugins/Onepassword.cpp'
        'feature/secrets/plugins/Onepassword.hpp'
        'feature/secrets/plugins/Doppler.cpp'
        'feature/secrets/plugins/Doppler.hpp'
        'feature/secrets/plugins/Infisical.cpp'
        'feature/secrets/plugins/Infisical.hpp'
      ]
      def: ts: {
        onepassword: 'src/feature/secrets/sekreto/plugins/onepassword.ts'
        doppler: 'src/feature/secrets/sekreto/plugins/doppler.ts'
        infisical: 'src/feature/secrets/sekreto/plugins/infisical.ts'
      }
      def: go: {
        'onepassword.Plugin': 'feature/secrets/plugins/onepassword/onepassword.go'
