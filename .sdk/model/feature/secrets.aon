      # ONE module, TWO definitions - rust's spelling of the ts aws.ts
      # pair (upstream exports `pub fn secrets()` and `pub fn params()`).
      # plugins/aws/sigv4.rs and plugins/aws/crypto.rs go with it, and go
      # only with it: nothing outside aws.rs reaches into either.
      def: rust: {
        'aws::secrets': 'feature/secrets/plugins/aws.rs'
        'aws::params': 'feature/secrets/plugins/aws.rs'
      }
      # ONE module, TWO definitions - py's spelling of the ts aws.ts pair.
      # plugins/sigv4.py goes with it, and goes only with it.
      def: py: {
        awssecrets: 'pkg/feature/secrets/voxgig_sekreto/plugins/aws.py'
        awsparams: 'pkg/feature/secrets/voxgig_sekreto/plugins/aws.py'
      }
      # ONE module, TWO definitions - rb's spelling of the ts aws.ts
      # pair. plugins/sigv4.rb goes with it, and goes only with it.
      def: rb: {
        'VoxgigSekreto::Plugins::AWSSECRETS': 'feature/secrets/voxgig_sekreto/plugins/aws.rb'
        'VoxgigSekreto::Plugins::AWSPARAMS': 'feature/secrets/voxgig_sekreto/plugins/aws.rb'
      }
      # ONE module, TWO definitions - js's spelling of the ts aws.ts pair.
      # plugins/sigv4.js goes with it, and goes only with it.
      def: js: {
        awssecrets: 'src/feature/secrets/sekreto/plugins/aws.js'
        awsparams: 'src/feature/secrets/sekreto/plugins/aws.js'
      }
      # ONE file, TWO definitions - php's spelling of the ts aws.ts pair.
      # plugins/sigv4.php goes with it, and goes only with it.
      def: php: {
        awssecrets: 'feature/secrets/sekreto/plugins/aws.php'
        awsparams: 'feature/secrets/sekreto/plugins/aws.php'
      }
      # ONE file, TWO definitions - csharp's spelling of the ts aws.ts
      # pair. The class is `AwsPlugins`, not `Aws`: the provider TYPES in
      # Aws.cs are named AwsSecretsProvider/AwsParamsProvider and the
      # definition holder cannot collide with them.
      # plugins/Sigv4.cs goes with it, and goes only with it.
      def: csharp: {
        'AwsPlugins.Secrets': 'feature/secrets/plugins/Aws.cs'
        'AwsPlugins.Params': 'feature/secrets/plugins/Aws.cs'
      }
      # ONE class, TWO definitions - java's spelling of the ts aws.ts
      # pair. plugins/Sigv4.java does NOT go with it: see the java note
      # at the head of this `plugin` block.
      def: java: {
        'Aws.SECRETS': 'feature/secrets/sekreto/plugins/Aws.java'
        'Aws.PARAMS': 'feature/secrets/sekreto/plugins/Aws.java'
      }
      # ONE file, TWO definitions - scala's spelling of the ts aws.ts pair.
      # plugins/Sigv4.scala does NOT go with it: the java story repeats here
      # exactly (see the java note at the head of this `plugin` block),
      # because Sigv4.scala's `private[plugins] def uriescape` is also called
      # by Azuresecrets (`cloud`) and by Doppler, Infisical and Onepassword
      # (`saas`) - so listing it under `aws` let a saas-only or cloud-only
      # trim delete a file four other kinds compile against, and scalac fails
      # the whole build on it ("Not found: uriescape", x4 for saas, x2 for
      # cloud - measured, not predicted).
      def: scala: {
        'com.voxgig.sekreto.plugins.awssecrets': 'feature/secrets/sekreto/plugins/Aws.scala'
        'com.voxgig.sekreto.plugins.awsparams': 'feature/secrets/sekreto/plugins/Aws.scala'
      }
      # ONE file, TWO definitions - kotlin's spelling of the ts aws.ts
      # pair. plugins/Sigv4.kt does NOT go with it: the java story repeats
      # here exactly (see the java note at the head of this `plugin`
      # block), because Sigv4.kt's `internal fun uriescape` is also called
      # by Azuresecrets (`cloud`) and by Doppler, Infisical and
      # Onepassword (`saas`) - so listing it under `aws` would let a
      # saas-only trim delete a file four other kinds compile against, and
      # kotlinc fails the whole module on it.
      def: kotlin: {
        awssecrets: 'feature/secrets/sekreto/plugins/Aws.kt'
        awsparams: 'feature/secrets/sekreto/plugins/Aws.kt'
      }
      # ONE module, TWO definitions - perl's spelling of the ts aws.ts
      # pair (Aws.pm's `@EXPORT_OK` is `awssecrets awsparams sigv4`).
      # plugins/Sigv4.pm goes with it, and goes only with it: nothing
      # outside Aws.pm calls into it in this port.
      def: perl: {
        awssecrets: 'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Aws.pm'
        awsparams: 'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Aws.pm'
      }
      # ONE file, TWO definitions - dart's spelling of the ts aws.ts pair.
      # plugins/sigv4.dart goes with it, and so does plugins/crypto.dart:
      # this port has no crypto library to lean on, so SHA-256 and HMAC are
      # its own, and sigv4.dart is their only caller. Listing crypto.dart
      # anywhere else would let an aws-only trim delete the file sigv4.dart
      # compiles against - and `dart analyze` runs over the whole package,
      # so that is a hard build failure, not a degraded chain.
      def: dart: {
        awssecrets: 'lib/feature/secrets/sekreto/plugins/aws.dart'
        awsparams: 'lib/feature/secrets/sekreto/plugins/aws.dart'
      }
      # ONE module, TWO definitions - clojure's spelling of the ts aws.ts
      # pair (upstream's aws.clj carries `awssecrets` and `awsparams`).
      # plugins/sigv4.clj goes with it, and goes only with it: nothing
      # outside aws.clj requires it in this port.
      def: clojure: {
        'voxgig.sekreto.plugins.aws/awssecrets': 'feature/secrets/voxgig/sekreto/plugins/aws.clj'
        'voxgig.sekreto.plugins.aws/awsparams': 'feature/secrets/voxgig/sekreto/plugins/aws.clj'
      }
      # ONE file, TWO definitions - elixir's spelling of the ts aws.ts pair.
      # plugins/sigv4.ex goes with it, and goes only with it: it holds
      # Sekreto.Plugins.Signing and Sekreto.Plugins.Sigv4, and aws.ex is
      # this port's only caller of either.
      def: elixir: {
        'Sekreto.Plugins.Aws.awssecrets': 'lib/projectname/feature/secrets/sekreto/plugins/aws.ex'
        'Sekreto.Plugins.Aws.awsparams': 'lib/projectname/feature/secrets/sekreto/plugins/aws.ex'
      }
      # ONE file, TWO definitions - swift's spelling of the ts aws.ts pair
      # (Aws.swift:258,264 at the tag). plugins/Sigv4.swift goes with it, and
      # goes only with it: `sigv4` is called from Aws.swift alone - this port
      # has no java/kotlin/scala `uriescape` story, checked at the tag. And so
      # does plugins/Crypto.swift: swift has no hashing in its standard
      # library (CryptoKit is Apple-only, swift-crypto a package), so SHA-256
      # and HMAC are the port's own and Sigv4.swift is their only caller (the
      # one other `hex` under plugins/ is a comment in Httpjson.swift).
      # Listing Crypto.swift anywhere else would let an aws-only trim delete
      # the file Sigv4.swift compiles against - swiftc fails the whole
      # SekretoPlugins module on it.
      def: swift: {
        awssecrets: 'Sources/ProjectNameSDK/feature/secrets/plugins/Aws.swift'
        awsparams: 'Sources/ProjectNameSDK/feature/secrets/plugins/Aws.swift'
      }
      # ONE file, TWO definitions - lean's spelling of the ts aws.ts pair.
      # Sigv4.lean, Crypto.lean AND Clock.lean travel with it: in this port
      # Aws.lean is their only importer (no saas/cloud kind reaches
      # `uriescape`, which lives in Httpjson.lean), so an aws-off trim
      # leaves nothing dangling. Clock.lean is the `sekreto_epoch_seconds`
      # extern's only caller; its two-line C stub is compiled with the curl
      # one whenever any plugin group is on, and is dead weight otherwise.
      def: lean: {
        'Sekreto.awssecrets': 'src/feature/secrets/sekreto/plugins/SekretoPlugins/Aws.lean'
        'Sekreto.awsparams': 'src/feature/secrets/sekreto/plugins/SekretoPlugins/Aws.lean'
      }
      # c: ONE file, TWO definitions - the c spelling of the ts aws.ts
      # pair, as go spells it aws.Secrets/aws.Params. plugins/sigv4.c AND
      # plugins/sha256.c ride with it and only with it: upstream's own
      # plugins/support.h says "sha256.c and nothing else. The aws plugin is
      # the only thing in the library that names these", and a symbol scan
      # of the port at the tag confirms aws.c is the sole caller of
      # sek_sigv4 / sek_sha256 / sek_hmac_sha256. Unlike java's and scala's
      # Sigv4, the c percent-encoder the other stores use (`sek_uriescape`)
      # lives in the ungrouped encode.c, so nothing outside this group
      # compiles against sigv4.c.
      def: c: {
        sek_plugin_awssecrets: 'feature/secrets/plugins/aws.c'
        sek_plugin_awsparams: 'feature/secrets/plugins/aws.c'
      }
      # lua: the FIELD each module exports (`require('...hashicorp').hashicorp`
      # is upstream's own spelling; aws.lua exports awssecrets AND awsparams),
      # and the module path under tm/lua - this target's root, which is also
      # Main_lua's Copy root, so the emitted exclude matches it. Config_lua
      # turns the path into a require (strip .lua, slashes to dots).
      # sigv4.lua is required by aws.lua ALONE in the lua port (checked at the
      # tag: gcpsecrets.lua reaches crypto.lua directly, never sigv4), so it
      # belongs to this group. crypto.lua is shared by aws and cloud and
      # ships ungrouped with the feature core.
      def: lua: {
        awssecrets: 'feature/secrets/sekreto/plugins/aws.lua'
        awsparams: 'feature/secrets/sekreto/plugins/aws.lua'
      }
      # ONE file, TWO definitions - zig's spelling of the ts aws.ts pair
      # (upstream all.zig: `awssecrets` and `awsparams`, both from aws.zig).
      # plugins/sigv4.zig goes with it, and goes only with it: at the tag
      # aws.zig is the ONLY file that `@import("sigv4.zig")` - the zig port
      # has no java/kotlin/scala `uriescape` story (checked by grep at the
      # tag), so an aws-off trim leaves nothing dangling.
      def: zig: {
        awssecrets: 'feature/secrets/plugins/aws.zig'
        awsparams: 'feature/secrets/plugins/aws.zig'
      }
      # ONE module, TWO definitions - ocaml's spelling of the ts aws.ts
      # pair (aws.ml defines `secretsplugin` and `paramsplugin`).
      # plugins/sigv4.ml and plugins/crypto.ml do NOT go with it: the
      # java/scala story repeats here (see the ocaml note at the head of
      # this `plugin` block), because `Sigv4.uriescape` is also called by
      # azuresecrets (`cloud`) and by doppler, infisical and onepassword
      # (`saas`), and crypto.ml has to compile before sigv4.ml.
      def: ocaml: {
        'Aws.secretsplugin': 'feature/secrets/plugins/aws.ml'
        'Aws.paramsplugin': 'feature/secrets/plugins/aws.ml'
      }
      # cpp: ONE file, TWO definitions (`Definition awssecrets();` and
      # `Definition awsparams();`, both in Aws.hpp) - the ts/go/py shape. The
      # SigV4 signer is aws-only in this port: Sigv4.hpp is included by Aws.cpp
      # and nothing else, so Sigv4.{cpp,hpp} go with `aws`; Crypto.cpp, which
      # Sigv4.cpp AND Tls.cpp include, stays with the feature core.
      def: cpp: {
        awssecrets: 'feature/secrets/plugins/Aws.cpp'
        awsparams: 'feature/secrets/plugins/Aws.cpp'
      }
    }

    # The only plugin that runs a CHILD PROCESS: the secretspec CLI
    # bridge. Gated on its own so an SDK never carries spawnSync into a
    # runtime that would refuse it.
    secretspec: {
      title: 'secretspec CLI bridge (child process)'
      needs: { fs: true }
      path: [
        'src/feature/secrets/sekreto/plugins/secretspec.ts'
        'feature/secrets/plugins/secretspec/secretspec.go'
        'feature/secrets/plugins/secretspec.rs'
        'feature/secrets/voxgig_sekreto/plugins/secretspec.py'
        'src/feature/secrets/sekreto/plugins/secretspec.js'
        'feature/secrets/voxgig_sekreto/plugins/secretspec.rb'
        'feature/secrets/sekreto/plugins/secretspec.php'
        'feature/secrets/plugins/SecretSpec.cs'
        'feature/secrets/sekreto/plugins/Secretspec.java'
        'feature/secrets/sekreto/plugins/Secretspec.scala'
        'feature/secrets/sekreto/plugins/Secretspec.kt'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Secretspec.pm'
        'lib/feature/secrets/sekreto/plugins/secretspec.dart'
        'feature/secrets/voxgig/sekreto/plugins/secretspec.clj'
        'feature/secrets/sekreto/plugins/secretspec.ex'
        'feature/secrets/plugins/Secretspec.swift'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Secretspec.lean'
        'feature/secrets/plugins/secretspec.c'
        'feature/secrets/sekreto/plugins/secretspec.lua'
        'feature/secrets/plugins/secretspec.zig'
        'feature/secrets/plugins/secretspec.ml'
        'feature/secrets/plugins/Secretspec.cpp'
        'feature/secrets/plugins/Secretspec.hpp'
      ]
      def: ts: {
        secretspec: 'src/feature/secrets/sekreto/plugins/secretspec.ts'
      }
      def: go: {
        'secretspec.Plugin': 'feature/secrets/plugins/secretspec/secretspec.go'
      }
      def: rust: {
        'secretspec::plugin': 'feature/secrets/plugins/secretspec.rs'
      }
      def: py: {
        secretspec: 'pkg/feature/secrets/voxgig_sekreto/plugins/secretspec.py'
      }
      def: rb: {
        'VoxgigSekreto::Plugins::SECRETSPEC': 'feature/secrets/voxgig_sekreto/plugins/secretspec.rb'
      }
      def: js: {
        secretspec: 'src/feature/secrets/sekreto/plugins/secretspec.js'
      }
      def: php: {
        secretspec: 'feature/secrets/sekreto/plugins/secretspec.php'
      }
      def: csharp: {
        'SecretSpec.Plugin': 'feature/secrets/plugins/SecretSpec.cs'
      }
      def: java: {
        'Secretspec.PLUGIN': 'feature/secrets/sekreto/plugins/Secretspec.java'
      }
      def: scala: {
        'com.voxgig.sekreto.plugins.secretspec': 'feature/secrets/sekreto/plugins/Secretspec.scala'
      }
      def: kotlin: {
        secretspec: 'feature/secrets/sekreto/plugins/Secretspec.kt'
      }
      # plugins/Proc.pm is NOT listed here either - see the perl note in
      # the `vault` group: it is a feature-core file both groups use.
      def: perl: {
        secretspec: 'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Secretspec.pm'
      }
      # dart has the php/perl SHARED-HELPER shape, and worse. `runcmd`
      # (Process.runSync) lives in plugins/httpjson.dart, which every
      # HTTP plugin imports, so it ships with the FEATURE CORE and cannot
      # be gated here at all - this group's `needs: { fs: true }` buys back
      # the CLI kind, not the child-process call itself. Stated rather than
      # hidden: a dart SDK with secrets active and a `[dotenv, env]` chain
      # links HttpClient and a Process.runSync it never reaches. Dead code,
      # not a defect, and an upstream shape issue (boru.dart calls runcmd
      # too, so it is not secretspec-only there either).
      def: dart: {
        secretspec: 'lib/feature/secrets/sekreto/plugins/secretspec.dart'
      }
      # clojure: plugins/proc.clj is NOT listed here (nor under `vault`).
      # It is the shared child-process helper BOTH boru.clj and
      # secretspec.clj require - php's runcmd.php story, one language over -
      # so it ships with the feature core and belongs to NO group.
      def: clojure: {
        'voxgig.sekreto.plugins.secretspec/secretspec': 'feature/secrets/voxgig/sekreto/plugins/secretspec.clj'
      }
      # plugins/proc.ex is NOT listed here - the php/perl SHARED-HELPER
      # story, one language over. The elixir port factors the child-process
      # spawn out of the two plugins that need it, so proc.ex is used by
      # Boru (`vault`) AND Secretspec (`secretspec`); listing its path in
      # either group would delete a file the other group's plugin calls.
      # It ships with the feature core instead, alongside http.ex and
      # httpjson.ex. Stated rather than hidden: a secrets-enabled elixir
      # SDK carries a `System.cmd("/bin/sh", ...)` source line even with
      # this group off. The code is unreachable without a plugin that calls
      # it, and it is an upstream shape issue rather than a local one.
      def: elixir: {
        'Sekreto.Plugins.Secretspec.secretspec': 'lib/projectname/feature/secrets/sekreto/plugins/secretspec.ex'
      }
      # plugins/Proc.swift is NOT listed here either - see the swift note in
      # the `vault` group: it is a feature-core file both groups use.
      def: swift: {
        secretspec: 'Sources/ProjectNameSDK/feature/secrets/plugins/Secretspec.swift'
      }
      # Proc.lean is NOT listed here - the php/perl SHARED-HELPER story:
      # Boru (`vault`) imports it too, so it ships with the feature core.
      def: lean: {
        'Sekreto.secretspec': 'src/feature/secrets/sekreto/plugins/SekretoPlugins/Secretspec.lean'
      }
      # plugins/proc.c is NOT listed here either - see the c note in the
      # `vault` group: it is a feature-core file both groups use.
      def: c: {
        sek_plugin_secretspec: 'feature/secrets/plugins/secretspec.c'
      }
      # lua: the FIELD each module exports (`require('...hashicorp').hashicorp`
      # is upstream's own spelling; aws.lua exports awssecrets AND awsparams),
      # and the module path under tm/lua - this target's root, which is also
      # Main_lua's Copy root, so the emitted exclude matches it. Config_lua
      # turns the path into a require (strip .lua, slashes to dots).
      def: lua: {
        secretspec: 'feature/secrets/sekreto/plugins/secretspec.lua'
      }
      def: zig: {
        secretspec: 'feature/secrets/plugins/secretspec.zig'
      }
      # plugins/runcmd.ml is NOT listed here either - see the ocaml note in
      # the `vault` group: it is a feature-core file both groups open.
      # This is the one ocaml group that needs NO transport (`needs` has no
      # `fetch`), so feature/secrets/feature.mk compiles runcmd.ml beside it and nothing of
      # the TLS chain: a secretspec-only ocaml SDK links no OpenSSL.
      def: ocaml: {
        'Secretspec.plugin': 'feature/secrets/plugins/secretspec.ml'
      }
      # cpp: see the vault group. plugins/Proc.cpp (`runcmd`) is shared with
      # Boru and ships with the feature core, not here.
      def: cpp: {
        secretspec: 'feature/secrets/plugins/Secretspec.cpp'
      }
    }
  }

  # rust: the TLS the vendored HTTP helper speaks.
  #
  # plugins/httpjson/http.rs opens its own sockets and names rustls
  # directly, so cargo needs the crates as DIRECT dependencies even though
  # both are already in the closure of the target's existing `ureq` dep
  # (rustls 0.23 + webpki-roots 0.26). `default: false` is load-bearing,
  # not tidiness: rustls with DEFAULT features pulls aws-lc-rs/aws-lc-sys
  # and a cmake C build, while the ring feature set below is what ureq
  # already compiles - so a secrets-enabled rust SDK adds no build at all.
  # Package_rust renders the dependency-TABLE form when either key is set.
  #
  # Feature deps are `active: true` by explicit opt-in (collectDeps), so an
  # SDK that does not select this feature names neither crate.
  deps: rust: {
    'rustls': {
      active: true, version: '0.23', kind: prod
      default: false, features: ['std', 'ring', 'tls12']
    }
    'webpki-roots': { active: true, version: '0.26', kind: prod }
  }


  # Transport role (station design §8.4).
  #
  # 'wrap', because the access-token exchange below has to SEE the response:
  # a spent token is discovered by the API answering 401, and the only place
  # to notice that and try again is around the transport. It wraps only when
  # `exchange.active` — with the exchange off this feature never touches the
  # transport, exactly as when its role was 'none' — but the role is a
  # DECLARATION of what the feature may do, not a report of what one
  # configuration does, so it is declared at its widest.
  transport: 'wrap'

  config: {
    options: {
      active: false

      # The sekreto provider chain, in first-hit order. Each entry is a
      # sekreto ProviderSpec ({ kind, name, ... }) or a provider object.
      # An explicit `apikey` option, when set, is placed AHEAD of these as
      # a `memory` store named 'options', so an explicit credential still
      # wins — by sekreto's own first-hit rule, not by special-casing.
      providers: []

      # The secret to resolve, for an API whose credential is not
      # apikey-shaped. The resolved value is written to options.apikey
      # regardless, because that is where prepareAuth looks.
      name: *'apikey' | string

      # sekreto caches resolved values by default. Off means every
      # resolve() asks the chain again; redaction still tracks values.
      cache: true

      # ACCESS-TOKEN EXCHANGE (the OAuth2 refresh grant, in miniature).
      #
      # Some APIs do not accept a long-lived credential at all: the secret the
      # chain above resolves is a REFRESH token, which buys a short-lived ACCESS
      # token from a token endpoint, and that access token is what every request
      # carries. The access token then expires, and the client is expected to buy
      # another without human help.
      #
      # Off by default, and inert when off: with `exchange.active: false` this
      # feature behaves exactly as it always did — resolve one secret, write it to
      # options.apikey. That is what keeps the change additive for every SDK
      # already using it.
      #
      # With it on, set `name` to the refresh secret (`name: 'refresh_token'`),
      # because `name` is what the chain is asked for.
      exchange: {
        active: false

        # The token endpoint, RELATIVE to options.base — the base already
        # carries whatever account or tenant segment the server URL declares,
        # so a relative path follows it without being told about it.
        path: 'auth/token'
        method: 'POST'

        # The JSON field the refresh credential is SENT in, and the field the
        # access token comes back in. Named rather than assumed: `access_token`
        # and `refresh_token` are the OAuth2 spelling, and plenty of APIs use
        # their own.
        request: 'refresh_token'
        response: 'access_token'

        # An explicit refresh token, given in code. It becomes the FIRST
        # provider in the chain, so it wins by sekreto's own first-hit rule —
        # the same seat `options.apikey` takes when no exchange is configured.
        # `options.apikey` cannot serve here: with an exchange configured it
        # means "an access token I already hold", which is the opposite kind
        # of credential.
        refresh: ''

        # Response statuses that mean "your access token is spent, buy
        # another". 401 is the answer every API in this shape gives; 403 is
        # listed by some, so it is configurable rather than assumed.
        statuses: [401]

        # How many times ONE request may buy a token and try again. One is
        # right: a second refusal on a token bought moments ago is a real
        # failure — a revoked refresh token, the wrong account — and retrying
        # it turns that into a spin instead of an error.
        retries: 1
      }
    }
  }

  # Resolution is ASYNC (a provider may do IO, and the exchange makes an
  # HTTP request) but prepareAuth is sync.
  # Entity ops await featureHook('PreSpec') before makeSpec, so this is
  # the one seam where the lookup can happen and still land in time.
  # Concurrent operations share the single in-flight promise.
  hook: {
    PreSpec: { active: true, await: true }
  }
}
