
main: kit: feature: secrets: {

  name: key()
  title: "Secret access: resolve the API credential through a provider chain, and exchange a refresh token for short-lived access tokens"
  version: '0.1.0'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'

  # `active` is deliberately NOT set here. The base schema defaults it
  # (`active: *false | boolean`), and in aontu a concrete value does not
  # yield to another concrete value — it CONFLICTS. Restating `active:
  # false` here would make a project's `main: kit: feature: secrets:
  # active: true` fail to unify, which is the same defect the publication
  # keys carry a warning about in model/target/ts.aon.
  #
  # So the feature is OFF until a project turns it on, in its own overlay
  # (model/project.aon), which `feature add` never overwrites.

  # Applicability (docs/design/feature-tags.md). The feature is a thin
  # layer over a VENDORED sekreto port, so it only applies to a target
  # whose feature container carries one. Without this tag the feature
  # would fan out to every target, and each one that generated would
  # carry an import for a class it has no source for.
  needs: { sekreto: true }

  # SPEC-DERIVED OPTIONS. apidef recognises an API's access-token exchange
  # in the spec and records it as model facts (info.security.exchange): the
  # endpoint's path and method, and the field names it sends and answers
  # with. This maps those facts onto `options.exchange` below, so a project
  # whose spec describes an exchange does not hand-copy its own API's token
  # endpoint into its model.
  #
  # What arrives is WHAT THE EXCHANGE IS, never that it should run:
  # `exchange.active` stays the project's call, because resolving a static
  # credential through this feature on an API that also has a token endpoint
  # is a legitimate configuration. Turning it on remains a deliberate act.
  spec: { authexchange: 'exchange' }

  # PLUGINS — the provider kinds, each carrying its own platform cost.
  #
  # This is what keeps a generated SDK lean. sekreto's core resolves a
  # chain and ships `env` and `memory`, which import nothing; every other
  # kind lives in its own module and REGISTERS ITSELF at import, so a kind
  # nobody imports is not in the build. These entries decide which of
  # those modules are generated at all.
  #
  # An SDK whose chain is `[dotenv, env]` — the common case, and
  # elementdemo's — needs `dotenv` alone. Before this it carried AWS
  # request signing and seven HTTP vault clients as well, because one
  # import reached every kind.
  #
  # `path` is DECLARED rather than conventional: these files are vendored
  # from sekreto, and both the vendoring guard and their own relative
  # imports pin them at upstream's directory depth.
  #
  # All inactive by default, like the feature itself. A project turns on
  # what its chain actually names.
  plugin: {
    # NO dotenv/file GROUP. Upstream sekreto made dotenv and file
    # BUILT-INS (src/provider/builtin.ts imports and instantiates them
    # unconditionally, and Sekreto.ts imports builtin.ts) — so they ship
    # with the feature core and CANNOT be a trimmable group: a trimmable
    # group here would let the trim delete two modules the vendored core
    # imports, and the SDK would not compile.
    #
    # plugins/httpjson.ts is likewise in no group: it is the shared HTTP
    # helper eight plugins import, so it ships with the feature core.
    #
    # php has a SECOND such file: plugins/runcmd.php, the child-process
    # helper that boru.php (`vault`) and secretspec.php (`secretspec`)
    # both require. It spans two groups, so no group may own it - trimming
    # either one would delete a file the other group's plugin requires.
    #
    # java has THREE such files, and the third is the surprising one.
    # plugins/Httpjson.java is the shared HTTP helper (eight plugins
    # import it) and plugins/Proc.java the child-process helper Boru
    # (`vault`) and Secretspec (`secretspec`) both use - the php story,
    # one language over. plugins/Sigv4.java is NOT aws-only in this port:
    # its package-private `uriescape` is also called by Doppler and
    # Infisical and Onepassword (`saas`) and by Azuresecrets (`cloud`), so
    # listing it under `aws` would let a saas-only trim delete a file
    # three other kinds compile against - and javac, which does no
    # dead-code elimination, fails the whole build on it. All three ship
    # with the java feature core and belong to NO group. The cost is real
    # and stated rather than hidden: a secrets-enabled java SDK links
    # HMAC-SHA256 and a ProcessBuilder call even with no group active.
    #
    # scala repeats the java Sigv4 story exactly, and it was got WRONG
    # first: plugins/Sigv4.scala was listed under `aws`, and its
    # `private[plugins] def uriescape` is called by Doppler, Infisical and
    # Onepassword (`saas`) and by Azuresecrets (`cloud`). A saas-only trim
    # then deleted it and scalac failed the SDK with four "Not found:
    # uriescape"; a cloud-only trim, with two. It ships with the scala
    # feature core and belongs to NO group. plugins/Httpjson.scala is the
    # other ungrouped scala file, and it is BOTH helpers in one: `fetchjson`
    # (eight plugins) and `runcmd`, the ProcessBuilder helper Boru (`vault`)
    # and Secretspec (`secretspec`) share, which is why scala needs two
    # ungrouped files where java needs three. Those two are the whole set:
    # every `private[plugins]` symbol crossing a file boundary is defined in
    # Httpjson.scala or Sigv4.scala, and nothing else is shared.

    #
    # c has the shared-helper shape too, and five files of it, every one
    # verified by a symbol scan of the port at the tag rather than read off
    # a comment: plugins/httpjson.c (the socket HTTP client eight kinds
    # call), plugins/tls.c (its OpenSSL binding - the ONLY file that names
    # OpenSSL), plugins/encode.c (`sek_uriescape` for four stores and
    # base64 for two), plugins/clock.c (token renewal time, SigV4's
    # timestamp) and plugins/proc.c (`sek_runcmd`, for boru in `vault` AND
    # secretspec in `secretspec`). All five belong to NO group. The two
    # plugin headers (sekretoplugins.h, support.h) are ungrouped for the
    # same reason. What makes c different from java/scala is that the
    # Makefile can see the trim: it compiles these helpers, and links
    # OpenSSL, only when at least one KIND file survived, so an
    # [env, memory] chain compiles the sekreto and voxgig/plugin cores
    # alone and links libc alone. sha256.c and sigv4.c are NOT shared in c
    # (aws.c is their only caller) and go with `aws`.
    #
    # ocaml has the java/scala Sigv4 shape AND the c Makefile-visible
    # trim, verified by an `open`/qualifier scan of the port at the tag:
    # plugins/sigv4.ml's `uriescape` is called by azuresecrets (`cloud`)
    # and by doppler, infisical and onepassword (`saas`), plugins/crypto.ml
    # is sigv4.ml's only caller but must compile before it, and
    # plugins/runcmd.ml (the child-process helper) is opened by boru
    # (`vault`) AND secretspec (`secretspec`). The transport chain
    # plugins/httpjson.ml -> http.ml -> tls.ml (+ tls_stubs.c, the OpenSSL
    # binding) is opened by every HTTPS kind. All seven belong to NO
    # group. What makes the cost zero when no kind needs them is the
    # generated feature/secrets/feature.mk (Main_ocaml): OCaml compiles
    # exactly the modules it is handed, in the order it is handed them, so
    # the fragment lists the transport helpers (and compiles the stub,
    # linking OpenSSL) only when an active group declares `needs.fetch`,
    # and runcmd.ml only when any kind is active. A chain of built-ins,
    # or `secretspec` alone, compiles neither and links no OpenSSL.
    #
    # cpp has four ungrouped shared helpers, read off the port's own
    # include lines at the tag rather than off a comment: plugins/Httpjson
    # .cpp (the socket HTTP client eight kinds include), plugins/Tls.cpp
    # (its OpenSSL binding, included by Httpjson.cpp - the ONLY file that
    # names OpenSSL), plugins/Crypto.cpp (SHA-256/HMAC, included by Tls.cpp
    # AND Sigv4.cpp) and plugins/Proc.cpp (`runcmd`, for Boru in `vault`
    # AND Secretspec in `secretspec`). All four belong to NO group, .hpp
    # and .cpp alike. Sigv4.{cpp,hpp} is included by Aws.cpp alone
    # (upstream's own `make lean` asserts only aws needs a digest) and goes
    # with `aws`. As in c, the Makefile can see the trim: it compiles the
    # helpers, and links OpenSSL, only when at least one KIND file survived,
    # so an [env, memory] chain compiles the sekreto and voxgig/plugin cores
    # alone and links libstdc++ alone.
    vault: {
      title: 'HashiCorp Vault and boru'
      needs: { fs: true, fetch: true }
      path: [
        'src/feature/secrets/sekreto/plugins/hashicorp.ts'
        'src/feature/secrets/sekreto/plugins/boru.ts'
        'feature/secrets/plugins/hashicorp/hashicorp.go'
        'feature/secrets/plugins/boru/boru.go'
        'feature/secrets/plugins/hashicorp.rs'
        'feature/secrets/plugins/boru.rs'
        'feature/secrets/voxgig_sekreto/plugins/hashicorp.py'
        'feature/secrets/voxgig_sekreto/plugins/boru.py'
        'src/feature/secrets/sekreto/plugins/hashicorp.js'
        'src/feature/secrets/sekreto/plugins/boru.js'
        'feature/secrets/voxgig_sekreto/plugins/hashicorp.rb'
        'feature/secrets/voxgig_sekreto/plugins/boru.rb'
        'feature/secrets/sekreto/plugins/hashicorp.php'
        'feature/secrets/sekreto/plugins/boru.php'
        'feature/secrets/plugins/Hashicorp.cs'
        'feature/secrets/plugins/Boru.cs'
        'feature/secrets/sekreto/plugins/Hashicorp.java'
        'feature/secrets/sekreto/plugins/Boru.java'
        'feature/secrets/sekreto/plugins/Hashicorp.scala'
        'feature/secrets/sekreto/plugins/Boru.scala'
        'feature/secrets/sekreto/plugins/Hashicorp.kt'
        'feature/secrets/sekreto/plugins/Boru.kt'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Hashicorp.pm'
        'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Boru.pm'
        'lib/feature/secrets/sekreto/plugins/hashicorp.dart'
        'lib/feature/secrets/sekreto/plugins/boru.dart'
        'feature/secrets/sekreto/plugins/hashicorp.ex'
        'feature/secrets/sekreto/plugins/boru.ex'
        'feature/secrets/voxgig/sekreto/plugins/hashicorp.clj'
        'feature/secrets/voxgig/sekreto/plugins/boru.clj'
        'feature/secrets/plugins/Hashicorp.swift'
        'feature/secrets/plugins/Boru.swift'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Hashicorp.lean'
        'src/feature/secrets/sekreto/plugins/SekretoPlugins/Boru.lean'
        'feature/secrets/plugins/hashicorp.c'
        'feature/secrets/plugins/boru.c'
        'feature/secrets/sekreto/plugins/hashicorp.lua'
        'feature/secrets/sekreto/plugins/boru.lua'
        'feature/secrets/plugins/hashicorp.zig'
        'feature/secrets/plugins/boru.zig'
        'feature/secrets/plugins/hashicorp.ml'
        'feature/secrets/plugins/boru.ml'
        'feature/secrets/plugins/Hashicorp.cpp'
        'feature/secrets/plugins/Hashicorp.hpp'
        'feature/secrets/plugins/Boru.cpp'
        'feature/secrets/plugins/Boru.hpp'
      ]
      def: ts: {
        hashicorp: 'src/feature/secrets/sekreto/plugins/hashicorp.ts'
        boru: 'src/feature/secrets/sekreto/plugins/boru.ts'
      }
      # go: package-qualified Definition symbols (each plugin is its own
      # package, and the symbol grammar is the language's own).
      def: go: {
        'hashicorp.Plugin': 'feature/secrets/plugins/hashicorp/hashicorp.go'
        'boru.Plugin': 'feature/secrets/plugins/boru/boru.go'
      }
      # rust: module-qualified `pub fn` paths under
      # feature/secrets/plugins/ (Main_rust emits the plugins.rs module
      # index from these, one `pub mod` per owning file). The path is
      # target-root-relative, as go's is.
      def: rust: {
        'hashicorp::plugin': 'feature/secrets/plugins/hashicorp.rs'
        'boru::plugin': 'feature/secrets/plugins/boru.rs'
      }
      # py: module paths relative to the SDK package root (Main_py copies
      # tm/py/pkg INTO <name>_sdk/, so the trim patterns drop the leading
      # pkg/ while Config_py derives the import module from it).
      def: py: {
        hashicorp: 'pkg/feature/secrets/voxgig_sekreto/plugins/hashicorp.py'
        boru: 'pkg/feature/secrets/voxgig_sekreto/plugins/boru.py'
      }
      # rb: constant names under VoxgigSekreto::Plugins, and the module
      # path under tm/rb that config.rb turns into a require_relative
      # (target-root-relative, as go's are).
      def: rb: {
        'VoxgigSekreto::Plugins::HASHICORP': 'feature/secrets/voxgig_sekreto/plugins/hashicorp.rb'
        'VoxgigSekreto::Plugins::BORU': 'feature/secrets/voxgig_sekreto/plugins/boru.rb'
      }
      # js: the same symbol set as ts, CommonJS module paths (Config_js
      # strips the leading src/ and the .js extension to build a require).
      def: js: {
        hashicorp: 'src/feature/secrets/sekreto/plugins/hashicorp.js'
        boru: 'src/feature/secrets/sekreto/plugins/boru.js'
      }
      # php: the plugin FUNCTION each file exports (a definition holds
      # closures, so php cannot name it with a constant), and the module
      # path under tm/php - this target's root, which is also config.php's
      # own directory, so the emitted require_once is that path verbatim.
      def: php: {
        hashicorp: 'feature/secrets/sekreto/plugins/hashicorp.php'
        boru: 'feature/secrets/sekreto/plugins/boru.php'
      }
      # csharp: the static class and Definition FIELD each file exports,
      # under namespace Voxgig.Sekreto.Plugins (Config_csharp emits the
      # symbol `global::`-qualified, so an inactive group leaves no
      # reference and no dangling using). The path is target-root-relative,
      # as go's is.
      def: csharp: {
        'Hashicorp.Plugin': 'feature/secrets/plugins/Hashicorp.cs'
        'Boru.Plugin': 'feature/secrets/plugins/Boru.cs'
      }
      # java: class-qualified Definition symbols (one class per kind),
      # and the file path under tm/java - this target's root, which is
      # also Main_java's Copy root, so the emitted exclude matches it.
      def: java: {
        'Hashicorp.PLUGIN': 'feature/secrets/sekreto/plugins/Hashicorp.java'
        'Boru.PLUGIN': 'feature/secrets/sekreto/plugins/Boru.java'
      }
      # scala: fully-qualified top-level `val`s (the scala port makes each
      # plugin a package-level Definition), so Config_scala names them
      # without an import. The path is target-root-relative, as go's is.
      def: scala: {
        'com.voxgig.sekreto.plugins.hashicorp': 'feature/secrets/sekreto/plugins/Hashicorp.scala'
        'com.voxgig.sekreto.plugins.boru': 'feature/secrets/sekreto/plugins/Boru.scala'
      }
      # kotlin: PLAIN TOP-LEVEL VALS (`val hashicorp: Definition = ...`),
      # imported by simple name - so ts-shaped keys, not java's
      # class-qualified ones. The path is target-root-relative, as go's is,
      # because Main_kotlin's Copy is rooted at tm/kotlin.
      def: kotlin: {
        hashicorp: 'feature/secrets/sekreto/plugins/Hashicorp.kt'
        boru: 'feature/secrets/sekreto/plugins/Boru.kt'
      }
      # perl: the bare sub each module exports (`@EXPORT_OK`), and the
      # module file under tm/perl - this target's root, which is also
      # Main_perl's Copy root, so the emitted exclude matches it. The
      # vendored tree keeps upstream's PACKAGE layout because perl
      # resolves by @INC, hence the Voxgig/Sekreto/Plugins/ depth.
      #
      # plugins/Proc.pm does NOT go with Boru: perl has a SECOND shared
      # helper (php's runcmd story, one language over). Proc.pm is used by
      # Boru (`vault`) AND Secretspec (`secretspec`), so it ships with the
      # feature core alongside Httpjson.pm and belongs to NO group -
      # listing it here would let a secretspec-only trim delete a file
      # Boru's `use` line needs, which is a load failure, not a degraded
      # chain.
      def: perl: {
        hashicorp: 'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Hashicorp.pm'
        boru: 'feature/secrets/plugins/Voxgig/Sekreto/Plugins/Boru.pm'
      }
      # dart: PLAIN TOP-LEVEL FINALS (`final Definition hashicorp = ...`),
      # imported by simple name with a `show` clause - so ts-shaped keys.
      # The path is target-root-relative, as go's is, because Main_dart's
      # Copy is rooted at tm/dart; `lib/` is part of it because dart's
      # feature container is lib/feature/<name>/, not a src/ tree.
      def: dart: {
        hashicorp: 'lib/feature/secrets/sekreto/plugins/hashicorp.dart'
        boru: 'lib/feature/secrets/sekreto/plugins/boru.dart'
      }
      # clojure: FULLY-QUALIFIED VARS (`voxgig.sekreto.plugins.hashicorp/hashicorp`)
      # - the clojure spelling of go's package-qualified symbol.
      # Config_clojure derives the `:require` namespace from the part before
      # the `/`. The path is target-root-relative, as go's is, because
      # Main_clojure's Copy is rooted at tm/clojure.
      def: clojure: {
        'voxgig.sekreto.plugins.hashicorp/hashicorp': 'feature/secrets/voxgig/sekreto/plugins/hashicorp.clj'
        'voxgig.sekreto.plugins.boru/boru': 'feature/secrets/voxgig/sekreto/plugins/boru.clj'
      }
      # elixir: fully-qualified CALLS - each plugin module answers its
      # definition from a zero-arity function (`Sekreto.Plugins.Hashicorp
      # .hashicorp()`), so Config_elixir emits the key with `()` appended
      # and needs no import at all: Elixir resolves modules globally, by
      # their `defmodule`, not by path. The `def` path is target-root
      # relative, while the `path` above is relative to Main_elixir's
      # `lib/projectname` Copy - the root the plugin trim matches against -
      # which is the same split py uses.
      #
      # plugins/proc.ex is NOT listed here: see the elixir note in the
      # `secretspec` group. It is a feature-core file both groups use.
      def: elixir: {
        'Sekreto.Plugins.Hashicorp.hashicorp': 'lib/projectname/feature/secrets/sekreto/plugins/hashicorp.ex'
        'Sekreto.Plugins.Boru.boru': 'lib/projectname/feature/secrets/sekreto/plugins/boru.ex'
      }
      # swift: PLAIN TOP-LEVEL LETS (`public let hashicorp: Definition = ...`)
      # in the vendored SekretoPlugins MODULE, named by simple symbol - so
      # ts-shaped keys. The `def` path is target-root-relative (tm/swift/...),
      # while the `path` entries above are relative to Main_swift's
      # Sources/ProjectNameSDK Copy - the root the plugin trim matches
      # against - which is the same split py uses.
      #
      # plugins/Proc.swift does NOT go with Boru: swift has the php/perl
      # SHARED-HELPER shape. `runcmd` lives in Proc.swift and is called by
      # Boru (`vault`) AND Secretspec (`secretspec`), so it ships with the
      # feature core beside plugins/Httpjson.swift and belongs to NO group -
      # a path listed in two groups is trimmed as soon as EITHER is off,
      # which would break the other. Upstream's own `make lean` builds every
      # non-AWS kind as `<Kind>.swift Httpjson.swift Proc.swift`.
      def: swift: {
        hashicorp: 'Sources/ProjectNameSDK/feature/secrets/plugins/Hashicorp.swift'
        boru: 'Sources/ProjectNameSDK/feature/secrets/plugins/Boru.swift'
      }
      # lean: QUALIFIED DEFINITIONS (`Sekreto.hashicorp`) - the value each
      # vendored SekretoPlugins module defines; Main_lean derives the import
      # (`import SekretoPlugins.Hashicorp`) from the path's module tail. The
      # path is target-root-relative, as go's is, because Main_lean's Copy is
      # rooted at tm/lean. Httpjson.lean and Proc.lean are in NO group: the
      # shared HTTP round-trip and child-process helpers ship with the
      # feature core (Boru reaches both), like php's runcmd.php. They cost
      # nothing when no kind imports them - Lake compiles an import closure,
      # not a directory - and the libcurl link goes with the plugin groups,
      # not with the core (see model/target/lean.aon).
      def: lean: {
        'Sekreto.hashicorp': 'src/feature/secrets/sekreto/plugins/SekretoPlugins/Hashicorp.lean'
        'Sekreto.boru': 'src/feature/secrets/sekreto/plugins/SekretoPlugins/Boru.lean'
      }
      # c: the `Definition *sek_plugin_<kind>(void)` constructor each
      # vendored plugin file defines (plugins/sekretoplugins.h declares all
      # ten; only the objects the link line names are carried). The path is
      # target-root-relative, as go's is, because Main_c's Copy is rooted
      # at tm/c. The generated feature/secrets/kinds.c (Config_c) calls
      # these and hands the list to the feature through feature_plugins().
      #
      # plugins/proc.c does NOT go with boru: it is the php/perl
      # SHARED-HELPER shape - `sek_runcmd` is called by boru (`vault`) AND
      # secretspec (`secretspec`), so it ships with the feature core
      # beside httpjson.c, tls.c, encode.c and clock.c and belongs to NO
      # group. The Makefile compiles the ungrouped helpers only when a
      # kind file is present, so they cost nothing (and need no OpenSSL
      # headers) in a chain that is [env, memory].
      def: c: {
        sek_plugin_hashicorp: 'feature/secrets/plugins/hashicorp.c'
        sek_plugin_boru: 'feature/secrets/plugins/boru.c'
      }
      # lua: the FIELD each module exports (`require('...hashicorp').hashicorp`
      # is upstream's own spelling; aws.lua exports awssecrets AND awsparams),
      # and the module path under tm/lua - this target's root, which is also
      # Main_lua's Copy root, so the emitted exclude matches it. Config_lua
      # turns the path into a require (strip .lua, slashes to dots).
      def: lua: {
        hashicorp: 'feature/secrets/sekreto/plugins/hashicorp.lua'
        boru: 'feature/secrets/sekreto/plugins/boru.lua'
      }
      # zig: the BARE export names upstream's plugins/all.zig re-exports
      # (`pub const hashicorp = @import("hashicorp.zig").hashicorp;`), so the
      # symbol is what Config_zig re-exports from the generated
      # feature/secrets/plugins.zig - the root of the `sekretoplugins` build
      # module, which is what makes the trim REAL in zig: the compiler
      # analyses only what a module root reaches, so a kind this file does
      # not name is neither compiled nor in the vocabulary. The path is
      # target-root-relative, as go's is, because Main_zig's Copy is rooted
      # at tm/zig. plugins/httpjson.zig is in NO group (eight kinds import
      # it by relative path, and the exchange's fetch of last resort is its
      # fetchjson), so it ships with the feature core.
      def: zig: {
        hashicorp: 'feature/secrets/plugins/hashicorp.zig'
        boru: 'feature/secrets/plugins/boru.zig'
      }
      # ocaml: MODULE-QUALIFIED FUNCTIONS (`Hashicorp.plugin`), the
      # `unit -> Defs.definition` each vendored kind module defines
      # (upstream's allplugins.ml names exactly these); Config_ocaml
      # appends `()`. OCaml's namespace is flat and resolved by -I, so the
      # symbol needs no import and the path is only what the plugin trim
      # matches and what feature/secrets/feature.mk compiles. The path is target-root
      # relative, as go's is, because Main_ocaml's Copy is rooted at
      # tm/ocaml.
      #
      # plugins/runcmd.ml does NOT go with boru: it is the php/perl
      # SHARED-HELPER shape (secretspec opens it too), so it ships with the
      # feature core and belongs to NO group - see the ocaml note at the
      # head of this `plugin` block.
      def: ocaml: {
        'Hashicorp.plugin': 'feature/secrets/plugins/hashicorp.ml'
        'Boru.plugin': 'feature/secrets/plugins/boru.ml'
      }
      # cpp: the bare `Definition <kind>()` factory each vendored kind file
      # defines in namespace sekreto (Hashicorp.hpp: `Definition hashicorp();`),
      # so the key is the unqualified function name; the generated
      # feature/secrets/kinds.cpp (Config_cpp) qualifies it as
      # `sekreto::hashicorp()` and includes the owning file's header. The path
      # is target-root-relative, as go's is, because Main_cpp's Copy is rooted
      # at tm/cpp; the .hpp rides in `path` beside its .cpp so the trim removes
      # the pair, and the .cpp is what the def names because it is what the
      # Makefile compiles.
      #
      # plugins/Proc.cpp does NOT go with Boru: it is the php/perl
      # SHARED-HELPER shape - `runcmd` is called by Boru (`vault`) AND
      # Secretspec (`secretspec`), so it ships with the feature core beside
      # Httpjson.cpp, Tls.cpp and Crypto.cpp and belongs to NO group. The
      # Makefile compiles the ungrouped helpers only when a kind file is
      # present, so they cost nothing (and need no OpenSSL headers) in a chain
      # that is [env, memory].
      def: cpp: {
        hashicorp: 'feature/secrets/plugins/Hashicorp.cpp'
        boru: 'feature/secrets/plugins/Boru.cpp'
      }
    }

