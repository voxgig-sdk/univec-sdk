main: kit: target: java: {

  title: Java
  ext: java
  comment: line: "//"
  module: name: 'univec'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability (docs/design/feature-tags.md). A vendored sekreto port
  # lives in this target's feature container (tm/java/feature/secrets/), so
  # a feature that resolves secrets through sekreto can apply here.
  provides: { sekreto: true }

  # Files earlier toolchains generated that this target has RETIRED
  # (vendor-tag rollout): the struct-corpus runner class
  # (test/RunnerSupport.java is support-only and RETAINED, name unchanged
  # so emitted call sites need no churn). `doctor` reports leftovers;
  # `doctor prune` deletes them.
  superseded: [
    'test/StructRunner.java'
  ]

  deps: &: {
    kind: *'prod' | string
  }

  # struct is inlined under utility/struct — no external runtime dep.
  # JSON parsing is the zero-dep utility/Json.java; HTTP transport is
  # java.net.http.HttpClient (JDK built-in). Tests need only JUnit,
  # declared directly in the generated pom.xml (test scope).
  deps: {}
}


main: kit: feature: &: target: java: deps: &: {
  kind: *'prod' | string
}


# Publication: tag-only for now (tag java/vX.Y.Z) — Maven Central
# publication via the Sonatype Central Portal is declared but pending.
#
# `target add <t>` OVERWRITES this file, so a project must never set its
# publication values here — voxgig-solardemo-sdk lost its pinned npm package
# name exactly that way. Set them in the project's own overlay
# (`model/project.aon`), which create-sdkgen creates once and never
# overwrites — NOT `model/sdk.aon`, which it rewrites on every scaffold.
#
# For that to work this file must LEAVE THOSE KEYS UNSET: in aontu a concrete
# value does not yield to another concrete value, it CONFLICTS, and two
# defaults conflict too. The schema (@voxgig/sdkgen/model/sdkgen.aon)
# already defaults `tag.active`, `registry.state`, `registry.active` and
# `registry.package`, so a project's concrete value wins over the default and
# repeating them here would only take that away.
#
# What remains below is per-target registry IDENTITY, which is not a project
# choice and stays concrete.
main: kit: target: java: publish: {
  registry: {
    name: 'maven-central'
    url: 'https://central.sonatype.com'
    vault: { recipe: 'maven', alias: 'central' }
  }
}


# Feature source may be trimmed to the model's selection. The one template
# needing the COMPLETE set is the cross-feature test suite, which
# constructs every *Feature class — so it is dropped alongside the
# features it exercises whenever the set is trimmed.
main: kit: target: java: feature: {
  trim: true
  fullset: ['test/FeatureTest.java']
}
