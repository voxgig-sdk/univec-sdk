
main: kit: target: ocaml: {

  title: OCaml
  ext: ml
  comment: line: "//"
  module: name: 'univec'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  provides: { sekreto: true, schema: true }

  # Files earlier toolchains generated that this target has RETIRED
  # (vendor-tag rollout): the hand-written corpus engine, replaced by
  # test/omni_resolver.ml over the vendored @voxgig/omni port
  # (test/vendor/omni/omni.ml). `doctor` reports leftovers; `doctor prune`
  # deletes them (jostraca only ever writes, it cannot delete).
  superseded: [
    'test/corpus_runner.ml'
  ]

  deps: &: {
    kind: *'prod' | string
  }

  deps: {}
}


main: kit: feature: &: target: ocaml: deps: &: {
  kind: *'prod' | string
}


main: kit: target: ocaml: publish: {
  registry: {
    name: 'opam'
    url: 'https://opam.ocaml.org'
    vault: { alias: 'opam', env: 'OPAM_PUBLISH_TOKEN' }
  }
}


main: kit: target: ocaml: feature: {
  trim: true
  fullset: []
}
