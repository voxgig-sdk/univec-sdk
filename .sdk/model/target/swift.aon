main: kit: target: swift: {

  title: "Swift"
  ext: swift
  comment: line: "//"
  module: name: 'univec'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability (docs/design/feature-tags.md). A vendored sekreto port
  # lives in this target's feature container
  # (tm/swift/Sources/ProjectNameSDK/feature/secrets/{plugin,sekreto,plugins}),
  # so a feature that resolves secrets through sekreto can apply here. The
  # three vendored trees are SEPARATE SwiftPM modules (VoxgigPlugin, Sekreto,
  # SekretoPlugins - upstream's own module boundary, and load-bearing: the
  # SDK, plugin and sekreto each declare a `Value`, a `Point` or a `Json`),
  # which Package_swift declares only when the feature is active.
  provides: { sekreto: true }

  # Retired by the move to the vendored @voxgig/omni corpus runner
  # (vendor-tag rollout): NOTHING, deliberately, and the empty list says so
  # rather than leaving the key off.
  #
  # Swift's corpus ENGINE was never a file of its own. It lived inline in
  # two places - `SdkRunner.runSet`/`matchDeep` inside
  # Tests/ProjectNameSDKTests/Runner.swift, and a second, independent
  # engine (`runset`/`canon`/`fixNull`) private to
  # Tests/ProjectNameSDKTests/StructUtilityTest.swift. Both were rewritten
  # IN PLACE onto Tests/ProjectNameSDKTests/OmniResolver.swift, so both
  # files KEEP THEIR NAMES and every emitted call site needs no churn:
  # Runner.swift is support-ONLY now (testJsonPath, makeCtxFromMap, fixCtx,
  # errFromMap, and the deepEqual/matchString/errCode the behavioural
  # suites use) and is RETAINED, exactly as csharp's Runner.cs and java's
  # RunnerSupport.java. There is therefore no whole-file leftover for
  # `doctor` to report or `doctor prune` to delete.
  superseded: []

  deps: &: {
    kind: *'prod' | string
  }

  # struct utility is vendored under Sources/ProjectNameSDK/Struct - no manifest dep needed.
  # The runtime uses only Foundation (URLSession + the in-tree JSON parser).
  deps: {}
}


main: kit: feature: &: target: swift: deps: &: {
  kind: *'prod' | string
}


# Publication: SwiftPM registry is git-tag only (publish pending).
#
# `target add <t>` OVERWRITES this file, so a project must never set its
# publication values here — voxgig-solardemo-sdk lost its pinned npm package
# name exactly that way. Set them in the project's own overlay
# (`model/project.aon`), which create-sdkgen creates once and never
# overwrites — NOT `model/sdk.aon`, which it rewrites on every scaffold.
#
# For that to work this file must LEAVE THOSE KEYS UNSET: in aontu a concrete
# value does not yield to another concrete value, it CONFLICTS, and two
# defaults conflict too. The schema (@voxgig/sdkgen/model/sdkgen.aon)
# already defaults `tag.active`, `registry.state`, `registry.active` and
# `registry.package`, so a project's concrete value wins over the default and
# repeating them here would only take that away.
#
# What remains below is per-target registry IDENTITY, which is not a project
# choice and stays concrete.
main: kit: target: swift: publish: {
  registry: {
    name: 'swiftpm'
    url: 'https://swift.org/package-manager'
    vault: { alias: 'swiftpm', env: 'SWIFTPM_TOKEN' }
  }
}


# Feature source may be trimmed to the model's selection. The one template
# needing the COMPLETE set is the cross-feature test suite, which
# constructs every *Feature type — so it is dropped alongside the
# features it exercises whenever the set is trimmed.
main: kit: target: swift: feature: {
  trim: true
  fullset: ['Tests/ProjectNameSDKTests/FeatureTest.swift']
}
