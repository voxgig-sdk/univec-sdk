
main: kit: target: perl: {

  title: Perl
  ext: pl
  comment: line: "#"
  module: name: 'univec'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability (docs/design/feature-tags.md). A vendored sekreto port
  # lives in this target's feature container (tm/perl/feature/secrets/),
  # so a feature that resolves secrets through sekreto can apply here.
  provides: { sekreto: true, schema: true }

  # Files earlier toolchains generated that this target has RETIRED
  # (vendor-tag rollout): the struct-corpus runner (t/runner.pm is
  # support-only and RETAINED). `doctor` reports leftovers; `doctor
  # prune` deletes them.
  superseded: [
    't/struct_runner.pm'
  ]

  deps: &: {
    kind: *'prod' | string
  }

  deps: {
  }
}


main: kit: feature: &: target: perl: deps: &: {
  kind: *'prod' | string
}


main: kit: target: perl: publish: {
  registry: {
    name: 'cpan'
    url: 'https://www.cpan.org'
    vault: { recipe: 'cpan', alias: 'cpan' }
  }
}
