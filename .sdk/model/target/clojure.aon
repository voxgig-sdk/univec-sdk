
main: kit: target: clojure: {

  title: Clojure
  ext: clj
  comment: line: ";"
  module: name: 'univec'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability (docs/design/feature-tags.md). A vendored sekreto port
  # lives in this target's feature container (tm/clojure/feature/secrets/),
  # so a feature that resolves secrets through sekreto can apply here.
  #
  # That container is ALSO a classpath root: Clojure resolves
  # `(require 'voxgig.sekreto.chain)` to voxgig/sekreto/chain.clj searched
  # from each :paths entry, never by relative import, so Package_clojure
  # adds `feature/secrets` to :paths whenever this feature is active.
  provides: { sekreto: true }

  deps: &: {
    kind: *'prod' | string
  }

  # RETIREMENT. Nothing is superseded by the omni migration, and the empty
  # list is the honest answer rather than an oversight: clojure never had a
  # separate hand-written runner FILE to retire. Its entry loop, matcher and
  # error handling lived INSIDE test/sdk/test/struct_corpus.clj alongside the
  # corpus wiring, and that file keeps its name and is rewritten in place, so
  # regeneration overwrites it and there is nothing for `doctor prune` to
  # delete. (Contrast go, which retired test/struct_runner_test.go, and lua,
  # which retired test/struct_runner.lua — both standalone files.)
  #
  # test/sdk/test_runner.clj is NOT superseded: despite the name it is the
  # tools.deps `-M:test` main entry point, not a corpus engine.
  superseded: []

  # struct is vendored under src/voxgig/struct.clj — no external dep.
  # The library itself needs only org.clojure/clojure (declared in deps.edn).
  deps: {
  }
}


main: kit: feature: &: target: clojure: deps: &: {
  kind: *'prod' | string
}


# Publication: Clojars registry (declared, publish pending — git-tag only).
#
# `target add <t>` OVERWRITES this file, so a project must never set its
# publication values here — voxgig-solardemo-sdk lost its pinned npm package
# name exactly that way. Set them in the project's own overlay
# (`model/project.aon`), which create-sdkgen creates once and never
# overwrites — NOT `model/sdk.aon`, which it rewrites on every scaffold.
#
# For that to work this file must LEAVE THOSE KEYS UNSET: in aontu a concrete
# value does not yield to another concrete value, it CONFLICTS, and two
# defaults conflict too. The schema (@voxgig/sdkgen/model/sdkgen.aon)
# already defaults `tag.active`, `registry.state`, `registry.active` and
# `registry.package`, so a project's concrete value wins over the default and
# repeating them here would only take that away.
#
# What remains below is per-target registry IDENTITY, which is not a project
# choice and stays concrete.
main: kit: target: clojure: publish: {
  registry: {
    name: 'clojars'
    url: 'https://clojars.org'
    vault: { alias: 'clojars' }
  }
}


# Feature source is NOT trimmed to the model's selection here: every
# feature lives inside a single generated module (src/sdk/features.clj),
# not in per-feature source files, so there is nothing per-feature to
# leave out. Trimming waits on that module becoming model-driven.
main: kit: target: clojure: feature: {
  trim: false
}
