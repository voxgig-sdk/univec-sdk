
main: kit: target: cpp: {

  title: 'C++'
  ext: hpp
  comment: line: "//"
  module: name: 'univec'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability tags (docs/design/feature-tags.md): this target vendors
  # the cpp port of @voxgig/sekreto (with voxgig/plugin under it) inside
  # its gated `feature/secrets/` container, so the `secrets` feature
  # applies. The port is a multi-translation-unit library where the SDK
  # itself is header-only; tm/cpp/Makefile compiles it into an archive only
  # through the generated feature/secrets/kinds.mk it `-include`s.
  provides: { sekreto: true }

  # Files earlier toolchains generated that this target has RETIRED
  # (vendor-tag rollout): the struct-corpus runner header
  # (test/runner_support.hpp is support-only — the file/env loaders,
  # sdk-test-control skips, make_ctx_from_map/fixctx, entity_list_to_data —
  # and is RETAINED, name unchanged, because the generated entity suites
  # include it). `doctor` reports leftovers; `doctor prune` deletes them.
  superseded: [
    'test/struct_runner.hpp'
  ]

  deps: &: {
    kind: *'prod' | string
  }

  # struct is vendored under utility/voxgigstruct — no external dep. The SDK
  # is header-only; JSON parsing is the vendored struct parser and the mock
  # transport needs no network. Tests need only a C++17 compiler (g++).
  #
  # The one external dependency a cpp SDK can have arrives with the
  # `secrets` feature, and only when it is active WITH a plugin group: the
  # vendored vault kinds link OpenSSL (-lssl -lcrypto, plugins/Tls.cpp),
  # and the feature's token-exchange transport of last resort (the
  # generated feature/secrets/kinds.cpp) rides on the same vendored HTTPS
  # client rather than adding libcurl - so there is exactly one HTTP stack
  # and one -l pair. The generated feature/secrets/kinds.mk turns it on
  # from the model, so an SDK with secrets inactive, or with no plugin
  # group, links libstdc++ and libc alone.
  deps: {}
}


main: kit: feature: &: target: cpp: deps: &: {
  kind: *'prod' | string
}


# Publication: header-only; publishing is the git tag cpp/vX.Y.Z (no registry).
#
# `target add <t>` OVERWRITES this file, so a project must never set its
# publication values here — voxgig-solardemo-sdk lost its pinned npm package
# name exactly that way. Set them in the project's own overlay
# (`model/project.aon`), which create-sdkgen creates once and never
# overwrites — NOT `model/sdk.aon`, which it rewrites on every scaffold.
#
# For that to work this file must LEAVE THOSE KEYS UNSET: in aontu a concrete
# value does not yield to another concrete value, it CONFLICTS, and two
# defaults conflict too. The schema (@voxgig/sdkgen/model/sdkgen.aon)
# already defaults `tag.active`, `registry.state`, `registry.active` and
# `registry.package`, so a project's concrete value wins over the default and
# repeating them here would only take that away.
#
# What remains below is per-target registry IDENTITY, which is not a project
# choice and stays concrete.
main: kit: target: cpp: publish: {
  registry: {
    name: 'none'
    url: ''
  }
}


# Feature source may be trimmed to the model's selection. The one template
# needing the COMPLETE set is the cross-feature test suite, which includes
# every feature/<name>.hpp — so it is dropped alongside the features it
# exercises whenever the set is trimmed.
main: kit: target: cpp: feature: {
  trim: true
  fullset: ['test/feature_test.cpp']
}
